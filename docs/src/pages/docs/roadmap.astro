---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { Content, getHeadings } from "../../../../IMPLEMENTATION_PLAN.md";

const headings = getHeadings().filter((h) => h.depth === 2);
---
<DocsLayout title="Roadmap" eyebrow="Project" description="The implementation plan, rendered from IMPLEMENTATION_PLAN.md in the repository. Component tables are generated from registry/catalog.json." headings={headings}>
  <div class="roadmap">
    <Content />
  </div>
</DocsLayout>

<style is:global>
  @layer custom {
    .roadmap > h1:first-child { display: none; }
    .roadmap h2 { padding-bottom: 0.5rem; margin-top: 3rem; font-size: 1.375rem; font-weight: 600; border-bottom: 1px solid var(--border); }
    .roadmap h3 { margin-top: 2rem; font-size: 1.125rem; font-weight: 600; }
    .roadmap table { display: block; width: 100%; overflow-x: auto; margin-block: 1rem 1.5rem; font-size: 0.8125rem; border-collapse: collapse; }
    .roadmap th, .roadmap td { padding: 0.5rem 0.75rem; text-align: start; vertical-align: top; border-bottom: 1px solid var(--border); }
    .roadmap th { font-weight: 500; color: var(--muted-foreground); }
    .roadmap ul:has(input[type="checkbox"]) { padding-inline-start: 0.25rem; list-style: none; }
    .roadmap li:has(> input[type="checkbox"]) { display: flex; gap: 0.5rem; align-items: baseline; }
    .roadmap :not(pre) > code { padding: 0.125rem 0.3rem; font-size: 0.8125em; background-color: var(--muted); border-radius: 0.25rem; }
    .roadmap pre { padding: 1rem; font-size: 0.8125rem; background-color: var(--bs-bg-1); border: 1px solid var(--border); border-radius: var(--bs-radius-6); overflow-x: auto; }
    .roadmap blockquote { padding: 0.75rem 1rem; color: var(--muted-foreground); border-inline-start: 3px solid var(--border); }
  }
</style>
