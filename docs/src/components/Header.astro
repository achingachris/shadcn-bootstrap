---
import { allPages } from "../lib/nav";
const path = Astro.url.pathname;
const links = [
  { href: "/docs/", label: "Docs" },
  { href: "/docs/components/", label: "Components" },
  { href: "/themes/", label: "Themes" },
];
const active = (href: string) => (href === "/docs/" ? path === "/docs/" || (path.startsWith("/docs/") && !path.startsWith("/docs/components")) : path.startsWith(href));
---
<header class="docs-header">
  <div class="docs-container docs-header-inner">
    <button type="button" class="btn btn-text btn-icon lg:d-none" data-sidebar-toggle aria-label="Toggle navigation" aria-controls="docs-sidebar" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a href="/" class="docs-logo">
      <img src="/favicon.svg" alt="" width="24" height="24">
      <span>shadcn-bootstrap</span>
    </a>
    <nav class="docs-header-nav d-none md:d-flex" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={active(l.href) ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="docs-header-actions">
      <form class="docs-jump d-none sm:d-block" role="search" data-jump>
        <label class="visually-hidden" for="docs-jump-input">Go to page</label>
        <input class="form-control form-control-sm" id="docs-jump-input" list="docs-pages" placeholder="Go to page…" autocomplete="off">
        <datalist id="docs-pages">
          {allPages.map((p) => <option value={p.title} data-href={p.href} />)}
        </datalist>
      </form>
      <a class="btn btn-text btn-icon" href="https://github.com/achinga/shadcn-bootstrap" aria-label="GitHub repository">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
      </a>
      <div class="docs-theme-toggle" role="group" aria-label="Color mode">
        <button type="button" class="btn btn-text btn-icon btn-sm" data-theme-set="light" aria-label="Light mode" title="Light">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>
        </button>
        <button type="button" class="btn btn-text btn-icon btn-sm" data-theme-set="dark" aria-label="Dark mode" title="Dark">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <button type="button" class="btn btn-text btn-icon btn-sm" data-theme-set="system" aria-label="System mode" title="System">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="docs-banner">Unofficial community port. Not affiliated with shadcn.</div>
</header>
