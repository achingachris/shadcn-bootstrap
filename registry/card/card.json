{
  "$schema": "../schema.json#/$defs/manifest",
  "name": "card",
  "title": "Card",
  "description": "Displays a card with header, content, and footer.",
  "tier": 1,
  "bootstrap": {
    "classes": [
      ".card",
      ".card-header",
      ".card-title",
      ".card-description",
      ".card-action",
      ".card-body",
      ".card-footer"
    ]
  },
  "files": [
    {
      "path": "card.css",
      "type": "css"
    },
    {
      "path": "card.example.html",
      "type": "example"
    }
  ],
  "registryDependencies": [],
  "cssVars": [
    "--card",
    "--card-foreground",
    "--muted-foreground",
    "--border",
    "--radius"
  ]
}
