{
  "$schema": "../schema.json#/$defs/manifest",
  "name": "alert",
  "title": "Alert",
  "description": "Displays a callout for user attention.",
  "tier": 1,
  "bootstrap": { "classes": [".alert", ".alert-title", ".alert-description", ".theme-danger"] },
  "files": [
    { "path": "alert.css", "type": "css" },
    { "path": "alert.example.html", "type": "example" }
  ],
  "registryDependencies": [],
  "cssVars": ["--card", "--card-foreground", "--muted-foreground", "--destructive", "--border", "--radius"],
  "variants": [{"name":"default","classes":"alert"},{"name":"destructive","classes":"alert theme-danger"}]
}
