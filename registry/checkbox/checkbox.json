{
  "$schema": "../schema.json#/$defs/manifest",
  "name": "checkbox",
  "title": "Checkbox",
  "description": "A control that allows the user to toggle between checked and not checked.",
  "tier": 1,
  "bootstrap": {
    "classes": [
      ".check",
      ".form-field"
    ]
  },
  "files": [
    {
      "path": "checkbox.css",
      "type": "css"
    },
    {
      "path": "checkbox.example.html",
      "type": "example"
    },
    {
      "path": "react/checkbox.tsx",
      "type": "react"
    },
    {
      "path": "vue/Checkbox.vue",
      "type": "vue"
    },
    {
      "path": "vue/index.ts",
      "type": "vue"
    },
    {
      "path": "angular/checkbox.ts",
      "type": "angular"
    }
  ],
  "registryDependencies": [
    "label"
  ],
  "cssVars": [
    "--input",
    "--primary",
    "--primary-foreground",
    "--ring",
    "--destructive"
  ]
}
