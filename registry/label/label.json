{
  "$schema": "../schema.json#/$defs/manifest",
  "name": "label",
  "title": "Label",
  "description": "Renders an accessible label associated with controls.",
  "tier": 1,
  "bootstrap": {
    "classes": [
      ".form-label"
    ]
